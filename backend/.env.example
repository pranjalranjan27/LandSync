# Database Connection (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/landsync_db

# Security & JWT Configuration
JWT_SECRET_KEY=landsync_hackathon_super_secret_jwt_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Directory
UPLOAD_DIR=./uploads

# Environment Mode (development / staging / production)
ENVIRONMENT=development
