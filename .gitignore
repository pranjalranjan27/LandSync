# ==============================================================================
# LandSync Root Version Control Exclusions (.gitignore)
# ==============================================================================

# Node dependencies
node_modules/
Frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend build outputs
Frontend/dist/
Frontend/dist-ssr/
dist/
build/

# Python runtime & test caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Local database instances & runtime uploads
*.sqlite3
*.db
backend/landsync.db
landsync.db
backend/uploads/
uploads/

# Environment secrets
.env
.env.*
!.env.example

# OS & Editor metadata
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
